<section class="el el-section el-goals">
  <div class="el-container">
    <div class="el-head">
      <div class="el-stack" style="gap: 12px;">
        {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
        <h2 class="el-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="el-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="el-goals__grid">
      {%- assign el_n = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if collection and c != blank and c.handle == collection.handle -%}{%- continue -%}{%- endif -%}
        {%- assign el_n = el_n | plus: 1 -%}
        {%- assign title = block.settings.title | default: c.title -%}
        <a
          class="el-goal el-goal--{{ block.settings.style }}"
          href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: class: 'el-goal__img', loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: title }}
          {%- endif -%}
          <span class="el-goal__num">{{ el_n | prepend: '0' }}</span>
          <span class="el-goal__body">
            <span class="el-goal__title">{{ title }}</span>
            {%- if block.settings.text != blank -%}<span class="el-goal__text">{{ block.settings.text }}</span>{%- endif -%}
            <span class="el-goal__cta">Shop now <span aria-hidden="true">→</span></span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
.el-goals__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
@media (max-width: 989px) { .el-goals__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
.el-goal { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; min-height: 340px; padding: 24px; border-radius: 16px; text-decoration: none; color: var(--el-ink); background: var(--el-surface); transition: transform .2s ease; }
@media (max-width: 749px) { .el-goal { min-height: 220px; padding: 18px; } }
.el-goal:hover { transform: translateY(-4px); }
.el-goal--dark { background: #000; color: #fff; }
.el-goal--charge { background: var(--el-charge); }
.el-goal__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.el-goal:has(.el-goal__img) { color: #fff; }
.el-goal:has(.el-goal__img)::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.7), rgba(0,0,0,0) 60%); }
.el-goal__num, .el-goal__body { position: relative; z-index: 1; }
.el-goal__num { font-family: var(--el-mono); font-size: 12px; letter-spacing: .08em; opacity: .7; }
.el-goal__body { display: flex; flex-direction: column; gap: 8px; }
.el-goal__title { font-family: var(--el-display); font-weight: 800; font-size: clamp(26px, 2.6vw, 38px); line-height: 1; letter-spacing: -0.035em; }
.el-goal__text { font-size: 15px; line-height: 1.4; opacity: .8; }
.el-goal__cta { margin-top: 8px; font-weight: 700; font-size: 14px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Shop by goal",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop by goal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hydration for how you live" },
    { "type": "text", "id": "text", "label": "Text", "default": "Same high-sodium formula. Pick the routine that fits you." }
  ],
  "blocks": [{
    "type": "goal", "name": "Goal", "limit": 8,
    "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title (defaults to collection name)" },
      { "type": "text", "id": "text", "label": "Short description" },
      { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
      { "type": "select", "id": "style", "label": "Tile colour", "default": "grey", "options": [
        { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Black" }, { "value": "charge", "label": "Lime" } ] }
    ]
  }],
  "presets": [{ "name": "Shop by goal" }]
}
{% endschema %}
