{%- comment -%}
  Banner colour per collection: set a collection metafield custom.hero_tone (dark / grey / charge),
  otherwise the Shop by goal collections use the same colours as their homepage tiles.
{%- endcomment -%}
{%- liquid
  assign tone = collection.metafields.custom.hero_tone.value
  if tone == blank
    case collection.handle
      when 'elite-athletes'
        assign tone = 'dark'
      when 'head-fuzz'
        assign tone = 'charge'
      when 'gym-goers', 'everyday'
        assign tone = 'grey'
      else
        assign tone = 'plain'
    endcase
  endif
  assign goal_handles = 'elite-athletes,gym-goers,everyday,head-fuzz' | split: ','
  assign is_goal = false
  if goal_handles contains collection.handle
    assign is_goal = true
  endif
-%}
<section class="el el-collection-hero el-ch--{{ tone }}">
  <div class="el-container el-stack el-ch__inner">
    <nav aria-label="Breadcrumb" class="el-ch__crumbs"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true"> › </span>{% if is_goal %}<span>Shop by goal</span><span aria-hidden="true"> › </span>{% endif %}<span aria-current="page">{{ collection.title }}</span></nav>
    {%- if is_goal -%}<span class="el-tag el-ch__tag el-hide-mobile">Shop by goal</span>{%- endif -%}
    <h1 class="el-h1 el-ch__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="el-lead el-ch__lead" id="el-ch-lead-{{ section.id }}" data-readmore>{{ collection.description }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="el-chips">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'el-icon', icon: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <p class="el-label el-ch__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</p>
  </div>
</section>
{% stylesheet %}
.el-ch__inner { gap: 16px; }
.el-ch__crumbs { font-size: 13px; color: inherit; opacity: .7; }
.el-ch__crumbs a { color: inherit; }
.el-ch__count { color: inherit; opacity: .7; }
.el-ch__lead { max-width: 720px; font-size: 17px; line-height: 1.55; }
.el-ch__lead p { margin: 0 0 .6em; }
.el-ch__lead p:last-child { margin-bottom: 0; }
.el-ch__lead a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.el-ch__lead a:hover { text-decoration-thickness: 2px; }
@media (max-width: 749px) {
  .el-ch__lead { font-size: 16px; --rm-lines: 2; }
  .el-ch__inner { gap: 10px; }
  .el-collection-hero .el-chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 4px calc(-1 * var(--el-gutter, 20px)) 0; padding: 0 var(--el-gutter, 20px); }
  .el-collection-hero .el-chips::-webkit-scrollbar { display: none; }
  .el-collection-hero .el-chips li { flex: 0 0 auto; padding: 6px 12px; font-size: 13px; }
  .el-hide-mobile { display: none !important; }
}
.el-ch--dark, .el-ch--grey, .el-ch--charge { border-bottom: 0; padding: 72px 0 56px; }
.el-ch--dark { background: #000; color: #fff; }
.el-ch--dark .el-h1, .el-ch--dark .el-lead { color: #fff; }
.el-ch--dark .el-lead { color: rgba(255,255,255,.78); }
.el-ch--dark .el-chips li { background: #151515; border-color: #2a2a2a; color: #fff; }
.el-ch--dark .el-chips .el-icon { stroke: var(--el-charge); }
.el-ch--dark :focus-visible { outline-color: var(--el-charge); }
.el-ch--grey { background: #F4F4F4; }
.el-ch--grey .el-chips li { background: #fff; }
.el-ch--charge { background: var(--el-charge); color: #000; }
.el-ch--charge .el-lead { color: #1f1f1f; }
.el-ch--charge .el-tag { background: #000; color: #fff; }
.el-ch--charge .el-chips li { background: rgba(255,255,255,.55); border-color: rgba(0,0,0,.15); }
@media (max-width: 749px) { .el-ch--dark, .el-ch--grey, .el-ch--charge { padding: 28px 0 24px; } .el-collection-hero { padding: 24px 0 16px; } }


.el-collection-hero { padding: 56px 0 24px; border-bottom: 1px solid var(--el-line); }
.el-chips { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.el-chips li { display: inline-flex; align-items: center; gap: 8px; background: var(--el-surface); border: 1px solid var(--el-line); border-radius: var(--el-radius-pill); padding: 8px 14px; font-size: 14px; font-weight: 500; }
.el-chips .el-icon { width: 18px; height: 18px; }
#ProductGridContainer .card__heading { font-family: var(--el-display); font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
#ProductGridContainer .card__inner { border-radius: var(--el-radius-md); background: var(--el-mist); }
#ProductGridContainer .price { font-size: 15px; }
#ProductGridContainer .quick-add__submit { border-radius: var(--el-radius-md); min-height: 48px; }
{% endstylesheet %}
{% schema %}
{
  "name": "Collection header",
  "tag": "div",
  "blocks": [{ "type": "chip", "name": "Highlight", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
      { "value": "drop", "label": "Droplet" }, { "value": "no-sugar", "label": "No sugar" }, { "value": "leaf", "label": "Leaf" },
      { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Delivery" }, { "value": "repeat", "label": "Subscription" }, { "value": "check", "label": "Tick" } ] },
    { "type": "text", "id": "text", "label": "Text", "default": "Free next-day UK delivery" } ] }],
  "presets": [{ "name": "Collection header" }]
}
{% endschema %}
