{%- comment -%}
  Interactive flavour explorer. Tabs switch the colour, product shot, tasting notes and add-to-basket variant.
  Each tab's "Name" must match the product's Flavour option value.
{%- endcomment -%}
{%- assign p = section.settings.product | default: all_products['electrolife-hydration'] -%}
<section class="el el-fx" id="el-fx-{{ section.id }}" style="--fx: {{ section.blocks.first.settings.colour }}; --fx-ink: {{ section.blocks.first.settings.ink }};">
  <div class="el-container">
    <div class="el-fx__head">
      <span class="el-tag">{{ section.settings.label }}</span>
      <h2 class="el-fx__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="el-fx__tabs" role="tablist" aria-label="Flavours">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" id="fx-tab-{{ section.id }}-{{ forloop.index }}" aria-controls="fx-panel-{{ section.id }}-{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          data-colour="{{ block.settings.colour }}" data-ink="{{ block.settings.ink }}" {{ block.shopify_attributes }}>
          <span class="el-fx__dot" style="background: {{ block.settings.colour }};" aria-hidden="true"></span>{{ block.settings.name }}
        </button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      {%- liquid
        assign v = nil
        for variant in p.variants
          if variant.option1 == block.settings.name and variant.available
            assign v = variant
            break
          endif
        endfor
        assign img = block.settings.image | default: v.featured_image | default: p.featured_image
      -%}
      <div class="el-fx__panel" role="tabpanel" id="fx-panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="fx-tab-{{ section.id }}-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %}>
        <div class="el-fx__media">
          {%- if img -%}{{ img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 45vw, 90vw', alt: img.alt | default: block.settings.name }}{%- endif -%}
        </div>
        <div class="el-fx__copy">
          <p class="el-fx__big">{{ block.settings.name }}</p>
          <p class="el-fx__note">{{ block.settings.note }}</p>
          {%- if block.settings.tasting != blank -%}
            <ul class="el-fx__notes">
              {%- assign notes = block.settings.tasting | split: ',' -%}
              {%- for n in notes -%}<li>{{ n | strip }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="el-btns">
            {%- if v -%}
              <button type="button" class="el-btn el-fx__add" data-fx-add="{{ v.id }}">Add {{ block.settings.name }} &middot; {{ v.price | money }}</button>
            {%- endif -%}
            <a class="el-btn el-btn--ghost el-fx__more" href="{% if v %}{{ v.url }}{% else %}{{ p.url }}{% endif %}">View details</a>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
.el-fx { background: #F7F7F2; background: color-mix(in srgb, var(--fx) 22%, #fff); transition: background-color .5s ease; }
.el-fx__head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
.el-fx__head .el-tag { align-self: flex-start; }
.el-fx__title { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: clamp(40px, 5vw, 72px); line-height: .95; letter-spacing: -0.04em; }
.el-fx__tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
.el-fx__tabs [role=tab] { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px; border-radius: 999px; border: 2px solid #000; background: #fff; color: #000; font: 700 16px var(--el-sans); cursor: pointer; transition: background .2s, color .2s; }
.el-fx__tabs [role=tab][aria-selected=true] { background: #000; color: #fff; }
.el-fx__tabs [role=tab]:focus-visible { outline: 3px solid #000; outline-offset: 3px; }
.el-fx__dot { width: 16px; height: 16px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.2); }
.el-fx__panel { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
.el-fx__panel[hidden] { display: none; }
.el-fx__panel:not([hidden]) .el-fx__media img { animation: el-fx-in .5s cubic-bezier(.2,.7,.2,1); }
.el-fx__panel:not([hidden]) .el-fx__copy { animation: el-fx-up .5s cubic-bezier(.2,.7,.2,1); }
.el-fx__media { border-radius: 24px; overflow: hidden; background: #F4F4F4; aspect-ratio: 1; }
.el-fx__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.el-fx__big { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: clamp(48px, 7vw, 112px); line-height: .9; letter-spacing: -0.045em; }
.el-fx__note { font-size: 20px; margin: 16px 0; color: #222; }
.el-fx__notes { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-wrap: wrap; gap: 8px; }
.el-fx__notes li { padding: 8px 14px; border-radius: 999px; background: var(--fx); color: var(--fx-ink); font-weight: 600; font-size: 14px; }
.el-fx__add { background: #000; color: #fff; }
.el-fx__add[aria-busy=true] { opacity: .6; }
@keyframes el-fx-in { from { opacity: 0; transform: scale(.96) rotate(-2deg); } to { opacity: 1; transform: none; } }
@keyframes el-fx-up { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
@media (max-width: 749px) {
  .el-fx__panel { grid-template-columns: 1fr; gap: 24px; }
  .el-fx__tabs { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; scrollbar-width: none; }
  .el-fx__tabs [role=tab] { flex: none; }
  .el-fx .el-btns { flex-direction: column; } .el-fx .el-btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) { .el-fx { transition: none; } .el-fx__panel .el-fx__media img, .el-fx__panel .el-fx__copy { animation: none !important; } }
{% endstylesheet %}
<script>
  (function () {
    var root = document.getElementById('el-fx-{{ section.id }}');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]'));
    function select(t, focus) {
      tabs.forEach(function (x) {
        var on = x === t;
        x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
      });
      root.style.setProperty('--fx', t.dataset.colour); root.style.setProperty('--fx-ink', t.dataset.ink);
      if (focus) t.focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(t); });
      t.addEventListener('keydown', function (e) {
        var k = e.key, n = null;
        if (k === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
        if (k === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
        if (k === 'Home') n = tabs[0]; if (k === 'End') n = tabs[tabs.length - 1];
        if (n) { e.preventDefault(); select(n, true); }
      });
    });
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-fx-add]'); if (!b) return;
      b.setAttribute('aria-busy', 'true');
      var drawer = document.querySelector('cart-drawer');
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(b.dataset.fxAdd), quantity: 1 }], sections: 'cart-drawer,cart-icon-bubble', sections_url: location.pathname }) })
        .then(function (r) { return r.json(); })
        .then(function (s) { b.removeAttribute('aria-busy'); if (drawer && drawer.renderContents && s.sections) drawer.renderContents(s); else location.href = '/cart'; })
        .catch(function () { location.href = '/cart'; });
    });
  })();
</script>
{% schema %}
{
  "name": "Flavour explorer",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "label", "label": "Label", "default": "Four flavours, one formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your flavour." }
  ],
  "blocks": [{ "type": "flavour", "name": "Flavour", "limit": 6, "settings": [
    { "type": "text", "id": "name", "label": "Name (must match the Flavour option)" },
    { "type": "text", "id": "note", "label": "Description" },
    { "type": "text", "id": "tasting", "label": "Tasting notes (comma separated)" },
    { "type": "color", "id": "colour", "label": "Colour", "default": "#E8CF4A" },
    { "type": "color", "id": "ink", "label": "Text colour on that colour", "default": "#000000" },
    { "type": "image_picker", "id": "image", "label": "Image (optional, defaults to the flavour's product photo)" } ] }],
  "presets": [{ "name": "Flavour explorer" }]
}
{% endschema %}
