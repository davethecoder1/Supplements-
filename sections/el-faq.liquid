{%- comment -%}
  FAQ accordion. If the current product or collection has a "FAQs" metafield (custom.faqs, JSON list of
  {"q": "...", "a": "<p>...</p>"}), those questions are shown; otherwise the blocks below are used.
{%- endcomment -%}
{%- liquid
  assign res = product | default: collection
  assign mf = res.metafields.custom.faqs.value
  assign use_mf = false
  if mf != blank and mf.size > 0
    assign use_mf = true
  endif
  assign heading = section.settings.heading
  if use_mf and section.settings.title_from_page
    assign heading = res.title | append: ': your questions'
  endif
  assign tag = section.settings.heading_tag | default: 'h2'
-%}
<section class="el el-section" id="faq">
  <div class="el-container el-faq">
    <{{ tag }} class="el-h2">{{ heading }}</{{ tag }}>
    <div class="el-faq__list">
      {%- if use_mf -%}
        {%- for item in mf -%}
          <details{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ item.q }}</summary>
            <div class="el-faq__answer">{{ item.a }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>{{ block.settings.question }}</summary>
            <div class="el-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- if use_mf or section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- if use_mf -%}
      {%- for item in mf -%}
      { "@type": "Question", "name": {{ item.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "Electrolife FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h2", "options": [{ "value": "h1", "label": "H1 (main page heading)" }, { "value": "h2", "label": "H2" }] },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "title_from_page", "label": "Use the product or collection name in the heading", "default": true, "info": "Applies when the page has its own FAQs (custom.faqs metafield)." }
  ],
  "blocks": [{ "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question" },
    { "type": "richtext", "id": "answer", "label": "Answer" } ] }],
  "presets": [{ "name": "Electrolife FAQ", "blocks": [
    { "type": "question", "settings": { "question": "How many sticks should I use?", "answer": "<p>One stick in 500 ml of water per session where you sweat heavily. Take the quiz for a suggestion based on your training.</p>" } },
    { "type": "question", "settings": { "question": "When should I drink it?", "answer": "<p>Before, during or after training. Many people sip one during sessions over an hour or in hot conditions.</p>" } },
    { "type": "question", "settings": { "question": "Is it suitable for vegans?", "answer": "<p>Yes. Full ingredients and allergen information are on the product page.</p>" } },
    { "type": "question", "settings": { "question": "Can I mix flavours?", "answer": "<p>Yes. The Variety Box has all four flavours in one box, so you can find your favourite before committing.</p>" } },
    { "type": "question", "settings": { "question": "How fast is delivery?", "answer": "<p>Free next-day delivery across the UK on orders placed before the daily cut-off.</p>" } }
  ] }]
}
{% endschema %}
