<section class="el el-section">
  <div class="el-container">
    <div class="el-stack" style="gap: 12px; margin-bottom: 40px;">
      {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
      <h2 class="el-h2">{{ section.settings.heading }}</h2>
    </div>
    <ol class="el-grid" style="list-style: none; margin: 0; padding: 0;">
      {%- for block in section.blocks -%}
        <li class="el-card el-stack" style="gap: 12px;" {{ block.shopify_attributes }}>
          <span style="font-family: var(--el-mono); font-size: 13px; color: var(--el-saline);">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="el-h3">{{ block.settings.title }}</h3>
          <p class="el-muted" style="margin: 0;">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Electrolife how it works",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One stick. One bottle. Done." }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Tear" },
    { "type": "text", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "Electrolife how it works", "blocks": [
    { "type": "step", "settings": { "title": "Tear", "text": "Single-serve sticks. In your gym bag, kit bag or back pocket." } },
    { "type": "step", "settings": { "title": "Pour", "text": "Into 500 ml of cold water. Shake for five seconds." } },
    { "type": "step", "settings": { "title": "Train", "text": "Drink before, during or after sessions where you sweat." } }
  ] }]
}
{% endschema %}
