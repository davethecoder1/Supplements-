{%- comment -%}
  "Read up": three Learn articles chosen for the current collection or product (internal links for SEO).
{%- endcomment -%}
{%- liquid
  assign key_handle = collection.handle
  if product
    assign key_handle = 'product-' | append: product.handle
  endif
  case key_handle
    when 'product-electrolife-hydration'
      assign list = 'what-are-electrolytes,electrolytes-vs-water,how-much-sodium-is-too-much'
    when 'product-electrolife-hydration-variety-box'
      assign list = 'electrolytes-vs-water,coconut-water-vs-sports-drinks-vs-electrolyte-sticks,what-are-electrolytes'
    when 'product-electrolife-starter-kit'
      assign list = 'do-you-need-electrolytes-for-the-gym,electrolytes-vs-water,electrolytes-for-cycling'
    when 'product-electrolife-shaker-bottle'
      assign list = 'do-you-need-electrolytes-for-the-gym,electrolytes-in-hot-weather,what-are-electrolytes'
    when 'elite-athletes'
      assign list = 'electrolytes-for-cycling,salty-sweater-how-to-tell,how-much-sodium-do-i-need-when-running'
    when 'gym-goers'
      assign list = 'do-you-need-electrolytes-for-the-gym,electrolytes-vs-water,what-are-electrolytes'
    when 'everyday'
      assign list = 'electrolytes-in-hot-weather,electrolytes-vs-water,how-much-sodium-is-too-much'
    when 'head-fuzz'
      assign list = 'morning-after-what-helps,electrolytes-vs-water,what-are-electrolytes'
    when 'accessories', 'bundles-kits'
      assign list = 'what-are-electrolytes,electrolytes-vs-water,coconut-water-vs-sports-drinks-vs-electrolyte-sticks'
    else
      assign list = 'what-are-electrolytes,electrolytes-vs-water,how-much-sodium-is-too-much'
  endcase
  assign handles = list | split: ','
  assign blog = blogs[section.settings.blog]
-%}
{%- if blog != blank -%}
<section class="el el-section el-reads">
  <div class="el-container">
    <div class="el-reads__head">
      <h2 class="el-reads__title">{{ section.settings.heading }}</h2>
      <a class="el-reads__all" href="{{ blog.url }}">All guides <span aria-hidden="true">→</span></a>
    </div>
    <ul class="el-reads__grid" role="list">
      {%- for h in handles -%}
        {%- assign key = blog.handle | append: '/' | append: h -%}
        {%- assign a = articles[key] -%}
        {%- if a == blank -%}{%- continue -%}{%- endif -%}
        <li>
          <a class="el-read" href="{{ a.url }}">
            {%- if a.image -%}
              <span class="el-read__img">{{ a.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 85vw', alt: '' }}</span>
            {%- endif -%}
            <span class="el-read__body">
              <span class="el-read__title">{{ a.title }}</span>
              {%- if a.excerpt != blank -%}<span class="el-read__ex">{{ a.excerpt | strip_html | truncate: 120 }}</span>{%- endif -%}
              <span class="el-read__cta">Read the guide <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% stylesheet %}
.el-reads__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
.el-reads__title { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: var(--el-title, clamp(36px, 4.6vw, 68px)); line-height: .95; letter-spacing: -0.04em; }
.el-reads__all { font-weight: 700; color: inherit; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
.el-reads__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.el-reads__grid > li { display: flex; }
.el-read { display: flex; flex-direction: column; flex: 1 1 auto; background: #F4F4F4; border-radius: 20px; overflow: hidden; color: inherit; text-decoration: none; transition: transform .2s ease; }
.el-read:hover { transform: translateY(-4px); }
.el-read:focus-visible { outline: 2px solid #000; outline-offset: 3px; }
.el-read__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #E8E8E8; }
.el-read__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.el-read__body { display: flex; flex-direction: column; gap: 8px; padding: 22px; flex: 1 1 auto; }
.el-read__title { font: 800 22px/1.15 var(--el-display); letter-spacing: -0.02em; }
.el-read__ex { color: #333; font-size: 15px; line-height: 1.45; }
.el-read__cta { margin-top: auto; padding-top: 6px; font-weight: 700; font-size: 14px; }
@media (max-width: 989px) {
  .el-reads__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin: 0 calc(-1 * var(--el-gutter, 20px)); padding: 0 var(--el-gutter, 20px) 4px; scrollbar-width: none; }
  .el-reads__grid::-webkit-scrollbar { display: none; }
  .el-reads__grid > li { flex: 0 0 min(80%, 340px); scroll-snap-align: start; }
}
@media (prefers-reduced-motion: reduce) { .el-read { transition: none; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Read up (guides)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Read up." },
    { "type": "blog", "id": "blog", "label": "Blog" }
  ],
  "presets": [{ "name": "Read up (guides)" }]
}
{% endschema %}
