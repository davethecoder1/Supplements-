<section class="el el-section" id="science">
  <div class="el-container el-split el-nutri">
    <div class="el-stack">
      {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
      <h2 class="el-h2">{{ section.settings.heading }}</h2>
      <div class="el-lead">{{ section.settings.text }}</div>
      {%- assign claims = section.blocks | where: 'type', 'claim' -%}
      {%- if claims.size > 0 -%}
        <ul class="el-list">
          {%- for block in claims -%}<li class="el-check" {{ block.shopify_attributes }}>{% render 'el-check' %}<span>{{ block.settings.text }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="el-card">
      <div class="el-nutri__head"><span class="el-nutri__title">{{ section.settings.panel_title }}</span><span class="el-label" style="color: var(--el-ink-muted);">{{ section.settings.panel_note }}</span></div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'nutrient' -%}
          <div class="el-nutri__row" {{ block.shopify_attributes }}><span>{{ block.settings.name }}</span><span>{{ block.settings.value }}</span></div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.footnote != blank -%}<div class="el-note">{{ section.settings.footnote }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Electrolife nutrition",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "What's in a stick" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every milligram on show." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Most hydration drinks are built around sugar. Ours is built around sodium, the electrolyte you lose most of in sweat, with potassium and magnesium alongside.</p>" },
    { "type": "text", "id": "panel_title", "label": "Panel title", "default": "Per stick" },
    { "type": "text", "id": "panel_note", "label": "Panel note", "default": "Mixed in 500 ml" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "%NRV and full ingredients on the product page." }
  ],
  "blocks": [
    { "type": "nutrient", "name": "Nutrient row", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Sodium" },
      { "type": "text", "id": "value", "label": "Value", "default": "1,000 mg" } ] },
    { "type": "claim", "name": "Claim", "settings": [
      { "type": "text", "id": "text", "label": "Text", "info": "Use authorised GB nutrition and health claims only" } ] }
  ],
  "presets": [{ "name": "Electrolife nutrition", "blocks": [
    { "type": "nutrient", "settings": { "name": "Sodium", "value": "1,000 mg" } },
    { "type": "nutrient", "settings": { "name": "Potassium", "value": "200 mg" } },
    { "type": "nutrient", "settings": { "name": "Magnesium", "value": "60 mg" } },
    { "type": "nutrient", "settings": { "name": "Sugar", "value": "0 g" } },
    { "type": "claim", "settings": { "text": "Potassium contributes to normal muscle function." } },
    { "type": "claim", "settings": { "text": "Magnesium contributes to a reduction of tiredness and fatigue." } },
    { "type": "claim", "settings": { "text": "Mixes clear in 500 ml of water." } }
  ] }]
}
{% endschema %}
