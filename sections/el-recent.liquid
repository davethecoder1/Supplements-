{%- comment -%}
  "Recently viewed" products. Remembers the last few products a shopper opened (in their browser only)
  and shows them as cards. Hidden until there's something to show.
{%- endcomment -%}
<section class="el el-recent" id="el-recent-{{ section.id }}" hidden>
  <div class="page-width">
    <h2 class="el-h2 el-recent__title">{{ section.settings.heading }}</h2>
    <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list" data-el-recent-list></ul>
  </div>
</section>
{% stylesheet %}
.el-recent { padding: 48px 0 64px; }
.el-recent__title { font-size: clamp(28px, 3vw, 40px); margin-bottom: 24px; }
{% endstylesheet %}
<script>
  (function () {
    var root = document.getElementById('el-recent-{{ section.id }}');
    if (!root) return;
    var KEY = 'el_recent', MAX = 8, SHOW = {{ section.settings.limit | default: 4 }};
    var current = {{ product.handle | json }};
    var list = [];
    try { list = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
    var others = list.filter(function (h) { return h && h !== current; }).slice(0, SHOW);
    if (current) {
      try { localStorage.setItem(KEY, JSON.stringify([current].concat(others.concat(list).filter(function (h, i, a) { return h !== current && a.indexOf(h) === i; })).slice(0, MAX))); } catch (e) {}
    }
    if (!others.length) return;
    var ul = root.querySelector('[data-el-recent-list]');
    Promise.all(others.map(function (h) {
      return fetch('/products/' + encodeURIComponent(h) + '?section_id=el-recent-card').then(function (r) { return r.ok ? r.text() : ''; }).catch(function () { return ''; });
    })).then(function (htmls) {
      var html = htmls.map(function (t) { var d = document.createElement('div'); d.innerHTML = t; var li = d.querySelector('li.grid__item'); return li ? li.outerHTML : ''; }).join('');
      if (!html) return;
      ul.innerHTML = html;
      root.hidden = false;
    });
  })();
</script>
{% schema %}
{
  "name": "Recently viewed",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 4, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
