<section class="el el-section" style="padding-top: 48px;">
  <div class="el-container el-split" style="align-items: flex-start;">
    <div class="el-stack">
      {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
      <h2 class="el-h2">{{ section.settings.heading }}</h2>
      <div class="el-muted">{{ section.settings.text }}</div>
    </div>
    <div class="el-card el-table">
      <table>
        <thead><tr><th scope="col">Typical values</th><th scope="col">{{ section.settings.serving }}</th><th scope="col">%NRV*</th></tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.name }}</th><td>{{ block.settings.amount }}</td><td>{{ block.settings.nrv | default: '–' }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
      <p>{{ section.settings.footnote }}</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Nutrition table",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Full transparency" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nutrition information" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Potassium contributes to normal muscle function. Magnesium contributes to a reduction of tiredness and fatigue.</p>" },
    { "type": "text", "id": "serving", "label": "Serving column", "default": "Per stick" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "*NRV = Nutrient Reference Value." }
  ],
  "blocks": [{ "type": "row", "name": "Nutrient", "settings": [
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "text", "id": "amount", "label": "Amount" },
    { "type": "text", "id": "nrv", "label": "%NRV" } ] }],
  "presets": [{ "name": "Nutrition table", "blocks": [
    { "type": "row", "settings": { "name": "Energy", "amount": "20 kJ / 5 kcal" } },
    { "type": "row", "settings": { "name": "Sugars", "amount": "0 g" } },
    { "type": "row", "settings": { "name": "Sodium", "amount": "1,000 mg" } },
    { "type": "row", "settings": { "name": "Potassium", "amount": "200 mg", "nrv": "10%" } },
    { "type": "row", "settings": { "name": "Magnesium", "amount": "60 mg", "nrv": "16%" } }
  ] }]
}
{% endschema %}
