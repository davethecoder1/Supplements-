{%- assign reviews = section.blocks | where: 'type', 'review' -%}
{%- assign press = section.blocks | where: 'type', 'press' -%}
{%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
{%- comment -%} Hide the whole section until there is something real to show. {%- endcomment -%}
{%- unless product == blank and reviews.size == 0 and app_blocks.size == 0 and press.size == 0 -%}
<section class="el el-section" id="reviews">
  <div class="el-container">
    <div class="el-head">
      <div class="el-stack" style="gap: 12px;">
        {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
        <h2 class="el-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.summary != blank -%}<span style="font-family: var(--el-mono); font-size: 13px;" class="el-muted">{{ section.settings.summary }}</span>{%- endif -%}
    </div>
    {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
    {%- if product != blank and app_blocks.size == 0 -%}
      <div class="jdgm-widget jdgm-review-widget jdgm-outside-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}">{{ product.metafields.judgeme.widget }}</div>
    {%- endif -%}
    <div class="el-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
      {%- for block in reviews -%}
        <figure class="el-card el-review" {{ block.shopify_attributes }}>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>{{ block.settings.name }}{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {%- if press.size > 0 -%}
      <div class="el-press">
        <span>{{ section.settings.press_label }}</span>
        {%- for block in press -%}
          <span {{ block.shopify_attributes }}>{%- if block.settings.logo != blank -%}{{ block.settings.logo | image_url: height: 64 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}{{ block.settings.name }}{%- endif -%}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Electrolife reviews",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Verified reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tested in the gym, not the boardroom." },
    { "type": "text", "id": "summary", "label": "Rating summary", "info": "e.g. 4.8 / 5 from 1,200 reviews. Leave blank until you have reviews." },
    { "type": "text", "id": "press_label", "label": "Press label", "default": "As seen in" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "info": "Use real, verified customer reviews only" },
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" } ] },
    { "type": "press", "name": "Press logo", "settings": [
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "image_picker", "id": "logo", "label": "Logo" } ] },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Electrolife reviews" }]
}
{% endschema %}
