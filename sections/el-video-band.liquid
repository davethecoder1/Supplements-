{%- comment -%}
  Full-width looping video band.
  - Upload your own (e.g. AI-generated) video in the theme editor and it replaces the built-in clip.
  - Otherwise plays the built-in motion video from theme assets (landscape on desktop, portrait on phones).
  - Muted, looping, no autoplay for people who prefer reduced motion (poster shown, with a play button).
{%- endcomment -%}
<section class="el-vb" id="el-vb-{{ section.id }}">
  <div class="el-vb__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', class: 'el-vb__video', image_size: '1600x' }}
    {%- else -%}
      <video class="el-vb__video" muted loop playsinline preload="none"
        poster="{{ 'electrolife-pour-poster.jpg' | asset_url }}"
        data-src-desktop="{{ 'electrolife-pour.mp4' | asset_url }}"
        data-src-mobile="{{ 'electrolife-pour-portrait.mp4' | asset_url }}"
        data-poster-mobile="{{ 'electrolife-pour-portrait-poster.jpg' | asset_url }}"
        aria-label="{{ section.settings.alt | escape }}"></video>
    {%- endif -%}
  </div>
  <div class="el-vb__overlay">
    <div class="el-container el-vb__inner">
      {%- if section.settings.heading != blank -%}<h2 class="el-vb__title">{{ section.settings.heading | newline_to_br }}</h2>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="el-btn el-btn--charge" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
  <button type="button" class="el-vb__toggle" data-vb-toggle aria-label="Pause video" aria-pressed="false">
    <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor"/></svg>
    <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
  </button>
</section>
{% stylesheet %}
.el-vb { position: relative; background: #000; color: #fff; overflow: hidden; aspect-ratio: 16 / 9; max-height: 90vh; width: 100%; }
.el-vb__media, .el-vb__video { position: absolute; inset: 0; width: 100%; height: 100%; }
.el-vb__video { object-fit: cover; display: block; }
.el-vb__overlay { position: absolute; inset: auto 0 0 0; padding: 0 0 48px; background: linear-gradient(0deg, rgba(0,0,0,.55), rgba(0,0,0,0)); }
.el-vb__inner { display: flex; align-items: flex-end; justify-content: flex-end; gap: 24px; flex-wrap: wrap; }
.el-vb__title { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: clamp(32px, 4vw, 56px); line-height: .95; letter-spacing: -0.04em; color: #fff; }
.el-vb__toggle { position: absolute; top: 16px; right: 16px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.15); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(6px); }
.el-vb__toggle:focus-visible { outline: 2px solid var(--el-charge); outline-offset: 3px; }
.el-vb__toggle .i-play { display: none; }
.el-vb__toggle[aria-pressed="true"] .i-play { display: block; }
.el-vb__toggle[aria-pressed="true"] .i-pause { display: none; }
@media (max-width: 749px) { .el-vb { aspect-ratio: 4 / 5; max-height: none; } .el-vb__overlay { padding-bottom: 28px; } .el-vb__inner { flex-direction: column; align-items: flex-start; } }
{% endstylesheet %}
<script>
  (function () {
    var root = document.getElementById('el-vb-{{ section.id }}');
    if (!root) return;
    var v = root.querySelector('video'), btn = root.querySelector('[data-vb-toggle]');
    if (!v) { if (btn) btn.hidden = true; return; }
    var mobile = window.matchMedia('(max-width: 749px)').matches;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (v.dataset.srcDesktop) {
      v.src = mobile ? v.dataset.srcMobile : v.dataset.srcDesktop;
      if (mobile && v.dataset.posterMobile) v.poster = v.dataset.posterMobile;
    }
    var userPaused = reduce;
    function setBtn() { var paused = v.paused; btn.setAttribute('aria-pressed', paused ? 'true' : 'false'); btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video'); }
    btn.addEventListener('click', function () { if (v.paused) { userPaused = false; v.play(); } else { userPaused = true; v.pause(); } });
    v.addEventListener('play', setBtn); v.addEventListener('pause', setBtn);
    // Only play while on screen (saves battery and data)
    new IntersectionObserver(function (e) {
      if (e[0].isIntersecting && !userPaused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      else v.pause();
    }, { threshold: 0.25 }).observe(root);
    setBtn();
  })();
</script>
{% schema %}
{
  "name": "Video band",
  "tag": "div",
  "settings": [
    { "type": "video", "id": "video", "label": "Your video (optional)", "info": "Upload your own clip (for example an AI-generated video). Leave empty to use the built-in Electrolife animation." },
    { "type": "text", "id": "alt", "label": "Video description", "default": "An Electrolife stick being poured into a 500 ml bottle of water" },
    { "type": "textarea", "id": "heading", "label": "Heading (optional)", "info": "Leave empty if your video already has text in it." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Hydration" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Video band" }]
}
{% endschema %}
