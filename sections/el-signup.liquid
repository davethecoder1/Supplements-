{%- comment -%} Inline email sign-up band (for people who dismissed the pop-up). Same WELCOME15 offer, shown on success. {%- endcomment -%}
<section class="el el-signup" id="el-signup-{{ section.id }}">
  <div class="el-container el-signup__inner">
    {%- form 'customer', id: 'el-signup-form', class: 'el-signup__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="el-signup__done" role="status">
          <h2 class="el-signup__title">You're in. Here's 15% off.</h2>
          <p class="el-signup__code">WELCOME15</p>
        </div>
      {%- else -%}
        <div class="el-signup__copy">
          <h2 class="el-signup__title">{{ section.settings.heading }}</h2>
          <p class="el-signup__text">{{ section.settings.text }}</p>
        </div>
        <div class="el-signup__row">
          <input type="hidden" name="contact[tags]" value="newsletter, homepage">
          <label for="el-signup-email" class="visually-hidden">Email address</label>
          <input id="el-signup-email" type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address"{% if form.errors %} aria-invalid="true" aria-describedby="el-signup-err"{% endif %}>
          <button type="submit" class="el-btn">Get 15% off</button>
        </div>
        {%- if form.errors -%}<p id="el-signup-err" class="el-signup__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <p class="el-signup__small">No spam. Unsubscribe any time.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% stylesheet %}
.el-signup { background: var(--el-charge); padding: 72px 0; }
.el-signup__form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 48px; align-items: center; }
.el-signup__title { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: clamp(36px, 4.4vw, 64px); line-height: .95; letter-spacing: -0.04em; color: #000; }
.el-signup__text { margin: 12px 0 0; font-size: 18px; color: #1f1f1f; }
.el-signup__row { display: flex; gap: 10px; }
.el-signup__row input[type=email] { flex: 1; min-width: 0; box-sizing: border-box; min-height: 56px; border-radius: 999px; border: 2px solid #000; background: #fff; padding: 0 22px; font: 16px var(--el-sans); }
.el-signup__row input[type=email]:focus-visible { outline: 3px solid #000; outline-offset: 2px; }
.el-signup__small, .el-signup__err { grid-column: 2; margin: 0; font-size: 13px; color: #1f1f1f; }
.el-signup__err { color: #7a0d06; font-weight: 600; }
.el-signup__done { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.el-signup__code { margin: 0; font: 700 32px/1 var(--el-mono); letter-spacing: .12em; padding: 16px 24px; border: 3px dashed #000; border-radius: 16px; background: #fff; }
@media (max-width: 749px) { .el-signup { padding: 48px 0; } .el-signup__form { grid-template-columns: 1fr; } .el-signup__small, .el-signup__err { grid-column: 1; } .el-signup__row { flex-direction: column; } .el-signup__row .el-btn { width: 100%; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Email sign-up band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "15% off your first order." },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list for new flavours, hydration tips and offers. Your code appears straight away." }
  ],
  "presets": [{ "name": "Email sign-up band" }]
}
{% endschema %}
