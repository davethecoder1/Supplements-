{%- comment -%} "When to drink" interactive timeline: Before / During / After tabs along a progress line. {%- endcomment -%}
<section class="el el-section el-when" id="el-when-{{ section.id }}">
  <div class="el-container">
    <div class="el-when__head">
      <span class="el-tag">{{ section.settings.label }}</span>
      <h2 class="el-when__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="el-when__line" role="tablist" aria-label="When to drink">
      <span class="el-when__track" aria-hidden="true"><i data-fill></i></span>
      {%- for block in section.blocks -%}
        <button type="button" role="tab" id="when-tab-{{ section.id }}-{{ forloop.index }}" aria-controls="when-panel-{{ section.id }}-{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>
          <span class="el-when__dot" aria-hidden="true">{{ forloop.index }}</span>
          <span class="el-when__name">{{ block.settings.title }}</span>
          <span class="el-when__time">{{ block.settings.time }}</span>
        </button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      <div class="el-when__panel" role="tabpanel" id="when-panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="when-tab-{{ section.id }}-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %}>
        <p class="el-when__big">{{ block.settings.headline }}</p>
        <div class="el-when__text">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% stylesheet %}
.el-when { background: #F4F4F4; }
.el-when__head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
.el-when__head .el-tag { align-self: flex-start; }
.el-when__title { margin: 0; font-family: var(--el-display); font-weight: 800; font-size: clamp(40px, 5vw, 72px); line-height: .95; letter-spacing: -0.04em; }
.el-when__line { position: relative; display: grid; grid-template-columns: repeat(var(--n, 3), 1fr); gap: 12px; margin-bottom: 32px; }
.el-when__track { position: absolute; left: 28px; right: 28px; top: 27px; height: 4px; background: #D5D5D5; border-radius: 4px; }
.el-when__track i { display: block; height: 100%; width: 0; background: #000; border-radius: 4px; transition: width .45s cubic-bezier(.2,.7,.2,1); }
.el-when__line [role=tab] { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; color: #000; font: inherit; min-height: 44px; }
.el-when__line [role=tab]:nth-child(n+3) { align-items: center; text-align: center; }
.el-when__line [role=tab]:last-child { align-items: flex-end; text-align: right; }
.el-when__dot { width: 58px; height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; border: 3px solid #D5D5D5; font: 800 22px var(--el-display); transition: background .25s, border-color .25s, transform .25s; }
.el-when__line [aria-selected=true] .el-when__dot { background: var(--el-charge); border-color: #000; transform: scale(1.08); }
.el-when__name { font: 800 24px var(--el-display); letter-spacing: -0.02em; }
.el-when__time { font: 500 13px var(--el-mono); color: #555; text-transform: uppercase; letter-spacing: .06em; }
.el-when__line [role=tab]:focus-visible .el-when__dot { outline: 3px solid #000; outline-offset: 3px; }
.el-when__panel { background: #fff; border-radius: 24px; padding: 32px; max-width: 860px; animation: el-when-in .4s cubic-bezier(.2,.7,.2,1); }
.el-when__panel[hidden] { display: none; }
.el-when__big { margin: 0 0 12px; font: 800 clamp(28px, 3vw, 40px)/1.05 var(--el-display); letter-spacing: -0.03em; }
.el-when__text { font-size: 18px; color: #333; }
.el-when__text p { margin: 0 0 .6em; }
@keyframes el-when-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
@media (max-width: 749px) { .el-when__dot { width: 48px; height: 48px; font-size: 18px; } .el-when__track { top: 22px; left: 24px; right: 24px; } .el-when__name { font-size: 18px; } .el-when__panel { padding: 22px; } }
@media (prefers-reduced-motion: reduce) { .el-when__panel { animation: none; } .el-when__track i, .el-when__dot { transition: none; } }
{% endstylesheet %}
<script>
  (function () {
    var root = document.getElementById('el-when-{{ section.id }}');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]')), fill = root.querySelector('[data-fill]');
    root.querySelector('.el-when__line').style.setProperty('--n', tabs.length);
    function select(t, focus) {
      var idx = tabs.indexOf(t);
      tabs.forEach(function (x) { var on = x === t; x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')).hidden = !on; });
      fill.style.width = (tabs.length > 1 ? idx / (tabs.length - 1) * 100 : 0) + '%';
      if (focus) t.focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(t); });
      t.addEventListener('keydown', function (e) {
        var n = e.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length] : e.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length] : e.key === 'Home' ? tabs[0] : e.key === 'End' ? tabs[tabs.length - 1] : null;
        if (n) { e.preventDefault(); select(n, true); }
      });
    });
  })();
</script>
{% schema %}
{
  "name": "When to drink",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Timing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "When to drink it." }
  ],
  "blocks": [{ "type": "moment", "name": "Moment", "limit": 4, "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Before" },
    { "type": "text", "id": "time", "label": "Timing", "default": "30–60 min before" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "text", "label": "Text" } ] }],
  "presets": [{ "name": "When to drink" }]
}
{% endschema %}
