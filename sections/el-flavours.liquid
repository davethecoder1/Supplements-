{%- assign p = section.settings.product -%}
<section class="el el-section el-flavours">
  <div class="el-container">
    <div class="el-head">
      <div class="el-stack" style="gap: 12px;">
        {%- if section.settings.label != blank -%}<p class="el-label">{{ section.settings.label }}</p>{%- endif -%}
        <h2 class="el-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="el-link" href="{{ section.settings.link | default: p.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="el-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign href = p.url
          assign price = p.price
          for v in p.variants
            if v.option1 == block.settings.name
              assign href = v.url
              assign price = v.price
              break
            endif
          endfor
        -%}
        <a class="el-flavour" href="{{ href | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <div class="el-flavour__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              <div class="el-stick" aria-hidden="true"><span style="background: {{ block.settings.swatch }};"></span></div>
            {%- endif -%}
          </div>
          <div class="el-flavour__row">
            <span class="el-flavour__name">{{ block.settings.name }}</span>
            {%- if p != blank -%}<span class="el-flavour__price">{{ price | money }}</span>{%- endif -%}
          </div>
          <span class="el-muted" style="font-size: 14px;">{{ block.settings.note }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Electrolife flavours",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Four flavours, one formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your flavour." },
    { "type": "product", "id": "product", "label": "Product", "info": "Each card links to the variant whose Flavour matches the card name" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Try the variety box" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [{ "type": "flavour", "name": "Flavour", "settings": [
    { "type": "text", "id": "name", "label": "Name (must match the variant)", "default": "Citrus Salt" },
    { "type": "text", "id": "note", "label": "Description" },
    { "type": "color", "id": "swatch", "label": "Swatch colour", "default": "#E8CF4A" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ] }],
  "presets": [{ "name": "Electrolife flavours", "blocks": [
    { "type": "flavour", "settings": { "name": "Citrus Salt", "note": "Sharp lemon-lime with a salted finish.", "swatch": "#E8CF4A" } },
    { "type": "flavour", "settings": { "name": "Watermelon", "note": "Light and fresh. Easy to drink in big volumes.", "swatch": "#E86F6F" } },
    { "type": "flavour", "settings": { "name": "Mixed Berry", "note": "Rounder and sweeter, still zero sugar.", "swatch": "#7E5BA6" } },
    { "type": "flavour", "settings": { "name": "Pure", "note": "Unflavoured. Add it to anything.", "swatch": "#D5DBD9" } }
  ] }]
}
{% endschema %}
