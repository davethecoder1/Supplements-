{%- comment -%}
  Purchase-type picker for products with Shopify Subscriptions selling plans.
  Usage (inside the main product section):
    {% assign fid = 'product-form-' | append: section.id %}
    {% render 'el-subscribe-picker', product: product, form_id: fid %}
  Reads every plan from the product, so changes made in the Subscriptions app show up automatically.
  One-time purchase is selected by default.
{%- endcomment -%}
{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign uid = form_id | append: '-plan' -%}
  <fieldset class="el-plan" id="{{ uid }}" data-el-plan>
    <legend class="el-plan__legend">How would you like it?</legend>

    <label class="el-plan__opt">
      <input type="radio" name="{{ uid }}" value="" checked>
      <span class="el-plan__body">
        <strong>One-time purchase</strong>
      </span>
    </label>

    {%- for group in product.selling_plan_groups -%}
      {%- for plan in group.selling_plans -%}
        {%- assign adj = plan.price_adjustments.first -%}
        <label class="el-plan__opt">
          <input type="radio" name="{{ uid }}" value="{{ plan.id }}">
          <span class="el-plan__body">
            <strong>
              {{ group.name }}
              {%- if adj and adj.value_type == 'percentage' and adj.value > 0 %}<span class="el-plan__save">Save {{ adj.value }}%</span>{% endif -%}
            </strong>
            <span class="el-plan__detail">{{ plan.name }}</span>
          </span>
        </label>
      {%- endfor -%}
    {%- endfor -%}

    <input type="hidden" name="selling_plan" value="" form="{{ form_id }}" disabled data-el-plan-input>
    <p class="el-plan__note">Subscriptions renew automatically. Pause, skip or cancel any time from your account.</p>
  </fieldset>

  <style>
    .el-plan { border: 0; padding: 0; margin: 8px 0 4px; display: grid; gap: 10px; }
    .el-plan__legend { font-weight: 600; margin-bottom: 4px; padding: 0; }
    .el-plan__opt { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; min-height: 56px; border: 1.5px solid #E4E4E4; border-radius: 14px; cursor: pointer; background: #fff; }
    .el-plan__opt:has(input:checked) { border-color: #000; background: #F4F4F4; }
    .el-plan__opt input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: #000; flex: none; }
    .el-plan__body { display: flex; flex-direction: column; gap: 2px; }
    .el-plan__body strong { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-weight: 700; }
    .el-plan__save { background: #D7F75B; color: #000; border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: 700; }
    .el-plan__detail { font-size: 14px; color: #555; }
    .el-plan__note { margin: 0; font-size: 13px; color: #555; }
  </style>
  <script>
    (function () {
      var box = document.getElementById({{ uid | json }});
      if (!box) return;
      var hidden = box.querySelector('[data-el-plan-input]');
      box.addEventListener('change', function (e) {
        if (e.target.type !== 'radio') return;
        hidden.value = e.target.value;
        hidden.disabled = !e.target.value;
      });
    })();
  </script>
{%- endif -%}
